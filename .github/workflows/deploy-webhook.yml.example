# GitHub Actions workflow — DEPLOY KIT (WEBHOOK, ~1-2s)
# ============================================================
# ⚠️ USE THIS ONLY IF YOU RAN webhook.sh (VPS only)!
# ------------------------------------------------------------
# WHO should use:  VPS users who ran: /bin/bash webhook.sh start
#                  on the server to start the listener.
#                  If you did NOT run this, the workflow will FAIL.
# WHAT it does:    GitHub POSTs to webhook.sh → ~1-2s deploys.
#                  💡 NATIVE option (even better): GitHub → Settings →
#                  Webhooks — no runner at all (this file is not needed
#                  either). Use this file only if you want the Actions UI/log.
# DEFAULT CHOICE:  most users should use deploy.yml.example (hosted) —
#                  this file is only for VPS users who ran webhook.sh.
# HOW TO COPY:     cp deploy-webhook.yml.example .github/workflows/deploy-webhook.yml
# ============================================================

name: Deploy (webhook)

on:
  push:
    branches: ["dev", "demo", "main"]   # ← edit: your branch names
    paths-ignore: ["*.md", "**/*.md", "docs/**"]  # doc pushes = 0 runner time
  workflow_dispatch:

concurrency:
  group: deploy-${{ github.ref }}
  cancel-in-progress: true

permissions: {}          # minimal — no unnecessary GITHUB_TOKEN

jobs:
  deploy:
    runs-on: ubuntu-latest
    timeout-minutes: 1
    steps:
      - name: Trigger deploy via webhook (~1-2s)
        env:
          DEPLOY_WEBHOOK_SECRET: ${{ secrets.DEPLOY_WEBHOOK_SECRET }}
          DEPLOY_WEBHOOK_URL: ${{ secrets.DEPLOY_WEBHOOK_URL }}
          BRANCH: ${{ github.ref_name }}
        run: |
          if [ -z "$DEPLOY_WEBHOOK_SECRET" ] || [ -z "$DEPLOY_WEBHOOK_URL" ]; then
            echo "❌ Set GitHub secrets: DEPLOY_WEBHOOK_SECRET + DEPLOY_WEBHOOK_URL (see README)"
            exit 1
          fi
          # sanitize branch before embedding in JSON (never trust the name)
          BRANCH="$(printf '%s' "$BRANCH" | tr -cd 'A-Za-z0-9._/-')"
          [ -n "$BRANCH" ] || { echo "❌ Empty/invalid branch name"; exit 1; }
          curl -fsS -m 8 -X POST "$DEPLOY_WEBHOOK_URL" \
            -H "X-Deploy-Secret: $DEPLOY_WEBHOOK_SECRET" \
            -H "Content-Type: application/json" \
            -d "{\"branch\": \"$BRANCH\", \"sha\": \"${GITHUB_SHA}\"}"
          echo "✅ Webhook triggered: $BRANCH ($GITHUB_SHA)"
