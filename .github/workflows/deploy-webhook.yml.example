# GitHub Actions workflow — DEPLOY KIT (WEBHOOK, ~1-2s)
# ------------------------------------------------------------
# Copy to your repo: .github/workflows/deploy-webhook.yml
# Edit: branch names. Secrets needed (same value as server):
#   DEPLOY_WEBHOOK_SECRET — the value in server config.sh
#   DEPLOY_WEBHOOK_URL    — http://SERVER_IP:9000/webhook/deploy/
# WHY: webhook POST is faster than SSH handshake (~1-2s).
# ⚠️ VPS only — server must run: /bin/bash webhook.sh start
#
# 💡 EVEN LIGHTER (0 runner): use GitHub's NATIVE webhook instead
#    (repo → Settings → Webhooks) — no Actions runner at all.
#    This workflow is only needed if you want the Actions UI/log.
# ============================================================

name: Deploy (webhook)

on:
  push:
    branches: ["dev", "demo", "main"]   # ← edit: your branch names
    paths-ignore: ["*.md", "**/*.md", "docs/**"]  # doc pushes = 0 runner time
  workflow_dispatch:

concurrency:
  group: deploy-${{ github.ref }}
  cancel-in-progress: true

permissions: {}          # minimal — no unnecessary GITHUB_TOKEN

jobs:
  deploy:
    runs-on: ubuntu-latest
    timeout-minutes: 1
    steps:
      - name: Trigger deploy via webhook (~1-2s)
        env:
          DEPLOY_WEBHOOK_SECRET: ${{ secrets.DEPLOY_WEBHOOK_SECRET }}
          DEPLOY_WEBHOOK_URL: ${{ secrets.DEPLOY_WEBHOOK_URL }}
        run: |
          if [ -z "$DEPLOY_WEBHOOK_SECRET" ] || [ -z "$DEPLOY_WEBHOOK_URL" ]; then
            echo "❌ Set GitHub secrets: DEPLOY_WEBHOOK_SECRET + DEPLOY_WEBHOOK_URL (see README)"
            exit 1
          fi
          curl -fsS -m 8 -X POST "$DEPLOY_WEBHOOK_URL" \
            -H "X-Deploy-Secret: $DEPLOY_WEBHOOK_SECRET" \
            -H "Content-Type: application/json" \
            -d "{\"branch\": \"${{ github.ref_name }}\", \"sha\": \"${{ github.sha }}\"}"
          echo "✅ Webhook triggered: ${{ github.ref_name }} (${{ github.sha }})"
