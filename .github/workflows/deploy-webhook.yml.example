# GitHub Actions workflow — DEPLOY KIT (WEBHOOK, ~1-2s)
# ============================================================
# ⚠️ SIRF TAB USE KARO AGAR AAPNE webhook.sh CHALAYA HO (VPS only)!
# ------------------------------------------------------------
# KAUN use kare:  SIRF VPS users jinhone server pe: /bin/bash webhook.sh start
#                 chala kar listener banaya ho.
#                 Agar yeh NAHI kiya to yeh workflow FAIL hoga.
# KYA karta hai:  GitHub POST bhejta hai webhook.sh ko → ~1-2s deploys.
#                 ️ NATIVE option (aur bhi behtar): GitHub → Settings →
#                 Webhooks — usme runner bilkul nahi chalta (yeh file bhi
#                 zaroori nahi). Yeh file sirf Actions UI/log chahiye ho to.
# DEFAULT CHOICE: zyada tar users ko deploy.yml.example (hosted) use karna
#                 chahiye — yeh file sirf webhook.sh wale VPS users ke liye.
# COPY KAISE:     cp deploy-webhook.yml.example .github/workflows/deploy-webhook.yml
# ============================================================

name: Deploy (webhook)

on:
  push:
    branches: ["dev", "demo", "main"]   # ← edit: your branch names
    paths-ignore: ["*.md", "**/*.md", "docs/**"]  # doc pushes = 0 runner time
  workflow_dispatch:

concurrency:
  group: deploy-${{ github.ref }}
  cancel-in-progress: true

permissions: {}          # minimal — no unnecessary GITHUB_TOKEN

jobs:
  deploy:
    runs-on: ubuntu-latest
    timeout-minutes: 1
    steps:
      - name: Trigger deploy via webhook (~1-2s)
        env:
          DEPLOY_WEBHOOK_SECRET: ${{ secrets.DEPLOY_WEBHOOK_SECRET }}
          DEPLOY_WEBHOOK_URL: ${{ secrets.DEPLOY_WEBHOOK_URL }}
        run: |
          if [ -z "$DEPLOY_WEBHOOK_SECRET" ] || [ -z "$DEPLOY_WEBHOOK_URL" ]; then
            echo "❌ Set GitHub secrets: DEPLOY_WEBHOOK_SECRET + DEPLOY_WEBHOOK_URL (see README)"
            exit 1
          fi
          curl -fsS -m 8 -X POST "$DEPLOY_WEBHOOK_URL" \
            -H "X-Deploy-Secret: $DEPLOY_WEBHOOK_SECRET" \
            -H "Content-Type: application/json" \
            -d "{\"branch\": \"${{ github.ref_name }}\", \"sha\": \"${{ github.sha }}\"}"
          echo "✅ Webhook triggered: ${{ github.ref_name }} (${{ github.sha }})"
