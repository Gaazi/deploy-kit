# GitHub Actions workflow — DEPLOY KIT (SELF-HOSTED runner, ~6s)
# ============================================================
# ⚠️ USE THIS ONLY IF YOU RAN runner.sh (VPS only)!
# ------------------------------------------------------------
# WHO should use:  VPS users who ran: /bin/bash runner.sh
#                  on the server to install their own runner.
#                  If you did NOT run this, the workflow will FAIL.
# WHAT it does:    your own runner (on the server) runs → NO VM boot
#                  → ~5-6s deploys, 0 Actions minutes (free).
# DEFAULT CHOICE:  most users should use deploy.yml.example (hosted) —
#                  this file is only for VPS users who ran runner.sh.
# HOW TO COPY:     cp deploy-selfhosted.yml.example .github/workflows/deploy-selfhosted.yml
# ============================================================

name: Deploy (self-hosted)

on:
  push:
    branches: ["dev", "demo", "main"]   # ← edit: your branch names
    paths-ignore: ["*.md", "**/*.md", "docs/**"]  # doc pushes = 0 runner time
  workflow_dispatch:

concurrency:
  group: deploy-${{ github.ref }}
  cancel-in-progress: true

permissions: {}          # minimal — no unnecessary GITHUB_TOKEN

jobs:
  deploy:
    runs-on: self-hosted   # the runner on the server itself
    timeout-minutes: 10
    steps:
      # No SSH needed — the runner lives on the same server as the deploy kit
      - name: Run deploy on the server
        env:
          SERVER_DEPLOY_PATH: ${{ secrets.SERVER_DEPLOY_PATH }}
        run: |
          DEPLOY_PATH="${SERVER_DEPLOY_PATH:-$HOME/deploy-kit/auto_deploy.sh}"
          /bin/bash "$DEPLOY_PATH" "${{ github.ref_name }}"
