# GitHub Actions workflow — DEPLOY KIT (SELF-HOSTED runner, ~6s)
# ============================================================
# ⚠️ SIRF TAB USE KARO AGAR AAPNE runner.sh CHALAYA HO (VPS only)!
# ------------------------------------------------------------
# KAUN use kare:  SIRF VPS users jinhone server pe: /bin/bash runner.sh
#                 chala kar apna khud ka runner install kiya ho.
#                 Agar yeh NAHI kiya to yeh workflow FAIL hoga.
# KYA karta hai:  aapka khud ka runner (server pe) chalta hai → NO VM boot
#                 → ~5-6s deploys, 0 Actions minutes (free).
# DEFAULT CHOICE: zyada tar users ko deploy.yml.example (hosted) use karna
#                 chahiye — yeh file sirf runner.sh wale VPS users ke liye.
# COPY KAISE:     cp deploy-selfhosted.yml.example .github/workflows/deploy-selfhosted.yml
# ============================================================

name: Deploy (self-hosted)

on:
  push:
    branches: ["dev", "demo", "main"]   # ← edit: your branch names
    paths-ignore: ["*.md", "**/*.md", "docs/**"]  # doc pushes = 0 runner time
  workflow_dispatch:

concurrency:
  group: deploy-${{ github.ref }}
  cancel-in-progress: true

permissions: {}          # minimal — no unnecessary GITHUB_TOKEN

jobs:
  deploy:
    runs-on: self-hosted   # the runner on the server itself
    timeout-minutes: 10
    steps:
      # No SSH needed — the runner lives on the same server as ~/deploy-kit
      - name: Run deploy on the server
        run: |
          /bin/bash "$HOME/deploy-kit/auto_deploy.sh" "${{ github.ref_name }}"
