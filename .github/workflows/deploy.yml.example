# GitHub Actions workflow — DEPLOY KIT (GENERIC)
# ------------------------------------------------------------
# Copy this file to YOUR repo: .github/workflows/deploy.yml
# Fill: branch names + server secrets (see README).
# Fire-and-forget: GitHub run ~6s, deploy runs in the background on the server.
# ============================================================

name: "Deploy"

on:
  push:
    branches: ["dev", "demo", "main"]   # ← edit: your branch names
  workflow_dispatch:

concurrency:
  group: deploy-${{ github.ref }}
  cancel-in-progress: true

jobs:
  deploy:
    name: Trigger Server Deploy via SSH
    runs-on: ubuntu-latest
    timeout-minutes: 1

    steps:
      - name: Trigger Deploy via SSH (fire-and-forget)
        env:
          SSH_PRIVATE_KEY: ${{ secrets.SSH_PRIVATE_KEY }}
          SERVER_HOST: ${{ secrets.SERVER_HOST }}
          SERVER_USER: ${{ secrets.SERVER_USER }}
          SSH_PORT: ${{ secrets.SSH_PORT || 22 }}
        run: |
          echo "🚀 Deploy trigger: ${{ github.ref_name }} (${{ github.sha }})"
          echo "$SSH_PRIVATE_KEY" > /tmp/deploy_key
          chmod 600 /tmp/deploy_key
          ssh -i /tmp/deploy_key -o StrictHostKeyChecking=no -o ConnectTimeout=10 \
            -o BatchMode=yes -p "$SSH_PORT" "$SERVER_USER@$SERVER_HOST" \
            "nohup /bin/bash /home/$SERVER_USER/deploy-kit/auto_deploy.sh ${{ github.ref_name }} >> /home/$SERVER_USER/deploy.log 2>&1 &"
          rm -f /tmp/deploy_key
