# GitHub Actions workflow — DEPLOY KIT (GENERIC, LITE)
# ------------------------------------------------------------
# Copy to your repo: .github/workflows/deploy.yml
# Edit: branch names + 4 GitHub Secrets (see README).
# LITE: no checkout, no build here — ONE tiny SSH job fires the
# deploy on the server in the background (~6s job, fire-and-forget).
# ============================================================

name: Deploy

on:
  push:
    branches: ["dev", "demo", "main"]   # ← edit: your branch names
    paths-ignore: ["*.md", "**/*.md"]   # doc-only pushes = 0 runner time
  workflow_dispatch:

concurrency:
  group: deploy-${{ github.ref }}
  cancel-in-progress: true

jobs:
  deploy:
    runs-on: ubuntu-latest
    timeout-minutes: 1
    steps:
      - name: Fire deploy on the server
        env:
          SSH_PRIVATE_KEY: ${{ secrets.SSH_PRIVATE_KEY }}
          SERVER_HOST: ${{ secrets.SERVER_HOST }}
          SERVER_USER: ${{ secrets.SERVER_USER }}
          SSH_PORT: ${{ secrets.SSH_PORT || 22 }}
        run: |
          echo "$SSH_PRIVATE_KEY" > /tmp/dk
          chmod 600 /tmp/dk
          ssh -i /tmp/dk -o StrictHostKeyChecking=no -o ConnectTimeout=10 -o BatchMode=yes \
            -p "$SSH_PORT" "$SERVER_USER@$SERVER_HOST" \
            "nohup /bin/bash ~/deploy-kit/auto_deploy.sh ${{ github.ref_name }} >> ~/deploy.log 2>&1 &"
