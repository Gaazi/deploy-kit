# GitHub Actions workflow — DEPLOY KIT (DEFAULT: hosted runner, FREE 2000 min/mo)
# ============================================================
# ✅ THIS IS THE FILE MOST USERS COPY
# ------------------------------------------------------------
# WHO should use:  EVERYONE (cPanel + VPS) — no extra setup needed
# WHAT it does:    GitHub's free hosted runner (ubuntu-latest) runs,
#                  sends a tiny SSH trigger (~1 min total).
#                  Free plan = 2000 min/month ≈ 2000 deploys.
# HOW TO COPY:     cp deploy.yml.example .github/workflows/deploy.yml
# THEN:            edit branch names + set 5 GitHub Secrets
#                  (SSH_PRIVATE_KEY, SERVER_HOST, SERVER_USER, SSH_PORT,
#                   SERVER_DEPLOY_PATH)
# SERVER_DEPLOY_PATH = full path to auto_deploy.sh ON THE SERVER.
#   Default (if secret not set): ~/deploy-kit/auto_deploy.sh
#   Put the kit anywhere on the server and set this secret to match.
#   Tip: if deploy.log shows "No such file or directory", this path is wrong.
# OTHER FILES:     deploy-selfhosted.yml  = only for VPS users who ran runner.sh
#                  deploy-webhook.yml     = only for VPS users who ran webhook.sh
# ============================================================

name: Deploy

on:
  push:
    branches: ["dev", "demo", "main"]   # ← edit: your branch names
    paths-ignore: ["*.md", "**/*.md", "docs/**"]  # doc pushes = 0 runner time
  workflow_dispatch:

concurrency:
  group: deploy-${{ github.ref }}
  cancel-in-progress: true

permissions: {}          # minimal — no unnecessary GITHUB_TOKEN

jobs:
  deploy:
    runs-on: ubuntu-latest
    timeout-minutes: 1
    steps:
      - name: Bootstrap deploy-kit on server (auto-install if missing)
        env:
          SSH_PRIVATE_KEY: ${{ secrets.SSH_PRIVATE_KEY }}
          SERVER_HOST: ${{ secrets.SERVER_HOST }}
          SERVER_USER: ${{ secrets.SERVER_USER }}
          SSH_PORT: ${{ secrets.SSH_PORT || 22 }}
          SERVER_DEPLOY_PATH: ${{ secrets.SERVER_DEPLOY_PATH }}
        run: |
          DEPLOY_PATH="${SERVER_DEPLOY_PATH:-~/deploy-kit/auto_deploy.sh}"
          KIT_DIR="$(dirname "$DEPLOY_PATH")"
          echo "$SSH_PRIVATE_KEY" > /tmp/dk
          chmod 600 /tmp/dk
          SSH_CMD="ssh -i /tmp/dk -o StrictHostKeyChecking=no -o ConnectTimeout=10 -o BatchMode=yes -p $SSH_PORT"
          # If the kit is not on the server yet, clone it from the public repo.
          # HTTPS clone — the kit repo is public, no SSH key needed on the server.
          $SSH_CMD "$SERVER_USER@$SERVER_HOST" "test -f '$DEPLOY_PATH'" 2>/dev/null || \
            $SSH_CMD "$SERVER_USER@$SERVER_HOST" "git clone --depth=1 https://github.com/Gaazi/deploy-kit.git '$KIT_DIR' && cp '$KIT_DIR/config.example.sh' '$KIT_DIR/config.sh'" 2>&1
          echo "✅ Kit ready at $DEPLOY_PATH"

      - name: Fire deploy on the server
        env:
          SSH_PRIVATE_KEY: ${{ secrets.SSH_PRIVATE_KEY }}
          SERVER_HOST: ${{ secrets.SERVER_HOST }}
          SERVER_USER: ${{ secrets.SERVER_USER }}
          SSH_PORT: ${{ secrets.SSH_PORT || 22 }}
          SERVER_DEPLOY_PATH: ${{ secrets.SERVER_DEPLOY_PATH }}
          BRANCH: ${{ github.ref_name }}
        run: |
          DEPLOY_PATH="${SERVER_DEPLOY_PATH:-~/deploy-kit/auto_deploy.sh}"
          BRANCH="$(printf '%s' "$BRANCH" | tr -cd 'A-Za-z0-9._/-')"
          [ -n "$BRANCH" ] || { echo "❌ Empty/invalid branch name"; exit 1; }
          echo "$SSH_PRIVATE_KEY" > /tmp/dk
          chmod 600 /tmp/dk
          ssh -i /tmp/dk -o StrictHostKeyChecking=no -o ConnectTimeout=10 -o BatchMode=yes \
            -p "$SSH_PORT" "$SERVER_USER@$SERVER_HOST" \
            "nohup /bin/bash $DEPLOY_PATH '$BRANCH' >> ~/deploy.log 2>&1 &"
